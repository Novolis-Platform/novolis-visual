<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.AssetStudio.Export</PackageId>
    <RootNamespace>Novolis.AssetStudio.Export</RootNamespace>
    <Description>Deterministic, host-neutral Asset Studio definition, code, packed, bake, documentation, and build exports.</Description>
    <PackageTags>assetstudio;visual;export;codegen;bake;manifest;deterministic</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novolis.AssetStudio.Core\Novolis.AssetStudio.Core.csproj" />
    <ProjectReference Include="..\Novolis.Visual.Assets\Novolis.Visual.Assets.csproj" />
    <ProjectReference Include="..\Novolis.Visual.Compile\Novolis.Visual.Compile.csproj" />
    <ProjectReference Include="..\Novolis.Visual.Baking\Novolis.Visual.Baking.csproj" />
    <ProjectReference Include="..\Novolis.Visual.CodeGen\Novolis.Visual.CodeGen.csproj" />
    <ProjectReference Include="..\Novolis.Visual.Materials\Novolis.Visual.Materials.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
