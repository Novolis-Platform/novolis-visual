<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Visual.Presets</PackageId>
    <RootNamespace>Novolis.Visual.Presets</RootNamespace>
    <Description>No-code material and procedural asset templates for Asset Studio.</Description>
    <PackageTags>visual;presets;templates;lightsaber;neon;glass;rocket;assetstudio</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novolis.Visual.Definitions\Novolis.Visual.Definitions.csproj" />
    <ProjectReference Include="..\Novolis.Visual.Materials\Novolis.Visual.Materials.csproj" />
    <ProjectReference Include="..\Novolis.Visual.Assets\Novolis.Visual.Assets.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
